<?php
$prikaziRezultat = false;
$ispis = "";

if (isset($_POST['_action_']) && $_POST['_action_'] == "TRUE") {
    $prikaziRezultat = true;
    $ocjene = array((int)$_POST['a'], (int)$_POST['b']);

    if ($ocjene[0] < 1 || $ocjene[0] > 5 || $ocjene[1] < 1 || $ocjene[1] > 5) {
        $ispis = '<p>Ocjena mora biti između 1 i 5!</p>';
    } else {
        $ispis .= '<p>Ocjena I. kolokvija: ' . $ocjene[0] . '<br>';
        $ispis .= 'Ocjena II. kolokvija: ' . $ocjene[1] . '</p>';
        $ispis .= '<hr>';

        if ($ocjene[0] == 1 || $ocjene[1] == 1) {
            $ispis .= '<p>Srednja ocjena iz predmeta: 1<br>';
            $ispis .= 'Konačna ocjena iz predmeta: 1</p>';
        } else {
            $prosjek = ($ocjene[0] + $ocjene[1]) / 2;
            $ispis .= '<p>Srednja ocjena iz predmeta: ' . $prosjek . '<br>';
            $ispis .= 'Konačna ocjena iz predmeta: ' . round($prosjek) . '</p>';
        }
    }
    $ispis .= '<p><a href="">Povratak</a></p>';
}
?>
