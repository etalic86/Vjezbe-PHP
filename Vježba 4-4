<?php
function jeLiProst($broj) {
    if ($broj <= 1) {
        return false;
    }

    for ($i = 2; $i < $broj; $i++) {
        if ($broj % $i == 0) {
            return false;
        }
    }

    return true;
}

$prostiBrojevi = array();
for ($n = 2; $n < 100; $n++) {
    if (jeLiProst($n)) {
        $prostiBrojevi[] = $n;
    }
}
?>
<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8">
    <title>Prosti brojevi</title>
</head>
<body style="margin: 20px; font-family: Arial, sans-serif;">
    <h1>Prosti brojevi manji od 100</h1>
    <p><?php echo implode(", ", $prostiBrojevi); ?></p>
</body>
</html>
